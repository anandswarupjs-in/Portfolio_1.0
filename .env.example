# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, include scheme. Needed in production behind HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Admin URL path (change in production to something non-obvious, keep trailing slash)
DJANGO_ADMIN_URL=admin/

# Database: sqlite (default, local) or mysql (production)
DB_ENGINE=sqlite
DB_NAME=anand_originals
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Superuser bootstrap (used by: python manage.py ensure_admin)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Production-only HTTPS settings (used when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
